{
  "name": "ほんのしおり",
  "short_name": "しおり",
  "description": "好きなページを写真で残す読書記録",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fdf6ee",
  "theme_color": "#fdf6ee",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic"] }]
    }
  }
}
